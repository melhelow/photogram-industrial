<div class="row mb-4">
  <div class="col-md-6 offset-md-3">
    <div class="card">
      <%= image_tag photo.image_url, class: "card-img-top" %>
      
      <div class="card-body">
        <h5 class="card-title"><%= photo.owner.username %></h5>
        <p class="card-text"><%= photo.caption %></p>

        <!-- Like / Unlike buttons -->
        <% if photo.liked_by?(current_user) %>
          <%= button_to "Un-like", photo_like_path(photo, current_user.likes.find_by(photo: photo)), method: :delete, class: "btn btn-outline-danger btn-sm me-2" %>
        <% else %>
          <%= button_to "Like", photo_likes_path(photo), method: :post, class: "btn btn-outline-primary btn-sm me-2" %>
        <% end %>

        <!-- Delete photo button (only for owner) -->
        <% if current_user == photo.owner %>
          <%= button_to photo_path(photo), method: :delete, data: { confirm: "Are you sure you want to delete this photo?" }, class: "btn btn-link btn-sm text-danger" do %>
            <i class="fas fa-trash fa-fw"></i>
          <% end %>
        <% end %>

        <span class="text-muted"><%= pluralize(photo.likes.count, "like") %></span>
        <!-- End Like / Delete section -->
      </div>

      <ul class="list-group list-group-flush">
        <% photo.comments.each do |comment| %>
          <%= render "comments/comment", comment: comment %>
        <% end %>
      </ul>

      <div class="card-body">
        <%= render "comments/form", comment: photo.comments.build %>
      </div>
    </div>
  </div>
</div>
