<% if @pending_follow_requests.present? %>
  <div class="alert alert-warning">
    <h2>Pending Follow Requests:</h2>
    <ul>
      <% @pending_follow_requests.each do |req| %>
        <li><%= req.sender.username %></li>
      <% end %>
    </ul>
  </div>
<% end %>



<div class="row mb-4">
  <div class="col-md-6 offset-md-3">
    <%= render "users/user", user: @user %>
  </div>
</div>

<div class="row mb-2">
  <div class="col-md-6 offset-md-3">
    <%= render "users/profile_nav", user: @user %>
  </div>
</div>

<% @user.own_photos.each do |photo| %>
  <%= render "photos/photo", photo: photo %>
<% end %>
