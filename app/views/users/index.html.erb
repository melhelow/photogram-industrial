<%# app/views/users/index.html.erb %>
<div class="container">
  <h1 class="my-4">Search Results</h1>
  
  <% if @users.any? %>
    <div class="list-group">
      <% @users.each do |user| %>
        <%= link_to user_path(user.username), class: "list-group-item list-group-item-action" do %>
          <div class="d-flex align-items-center">
            <% if user.avatar.attached? %>
              <%= image_tag user.avatar, class: "rounded-circle me-3", width: 50, height: 50 %>
            <% else %>
              <div class="bg-secondary rounded-circle me-3" style="width: 50px; height: 50px"></div>
            <% end %>
            <div>
              <h5 class="mb-0"><%= user.username %></h5>
              <p class="mb-0 text-muted"><%= user.full_name %></p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info">
      No users found matching "<strong><%= params.dig(:q, :username_cont) %></strong>"
    </div>
  <% end %>
</div>
